{
  "name": "stapel",
  "version": "1.3.0",
  "description": "Your Edubase school books in their own app: folders, notes on the pages, PDF export (macOS and Windows)",
  "main": "main.js",
  "author": "Korel Uyar",
  "license": "GPL-3.0",
  "homepage": "https://github.com/KorelUyar/stapel",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --mac && node scripts/sign-and-zip.js",
    "dist:win": "electron-builder --win"
  },
  "dependencies": {
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "electron": "45.4.1",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.koreluyar.stapel",
    "productName": "Stapel",
    "files": [
      "main.js",
      "preload.js",
      "edubase.js",
      "reader.js",
      "reader-preload.js",
      "update.js",
      "reader/**/*",
      "ui/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Stapel-Windows-Setup.exe"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Stapel",
      "deleteAppDataOnUninstall": false
    }
  }
}
