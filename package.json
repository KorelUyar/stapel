{
  "name": "edubase-downloader",
  "version": "1.0.0",
  "description": "Lädt Edubase-Bücher als PDF herunter (Desktop-App)",
  "main": "main.js",
  "author": "Korel Uyar",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "puppeteer": "^11.0.0"
  },
  "devDependencies": {
    "electron": "latest",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "ch.edubase.downloader",
    "productName": "Edubase Downloader",
    "files": [
      "**/*",
      "!**/*.pdf",
      "!.gitignore",
      "!*.md"
    ],
    "asarUnpack": [
      "node_modules/puppeteer/.local-chromium/**/*"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.education",
      "identity": null
    }
  }
}
