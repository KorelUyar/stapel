{
  "name": "stapel",
  "version": "1.0.0",
  "description": "Your Edubase school books in their own window, with PDF export",
  "main": "main.js",
  "author": "Korel Uyar",
  "license": "GPL-3.0",
  "homepage": "https://github.com/KorelUyar/stapel",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder && node scripts/sign-and-zip.js"
  },
  "dependencies": {
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "electron": "42.5.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.koreluyar.stapel",
    "productName": "Stapel",
    "files": [
      "main.js",
      "preload.js",
      "edubase.js",
      "ui/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null
    }
  }
}
