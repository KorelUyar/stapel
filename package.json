{
  "name": "edubase-downloader",
  "version": "2.0.0",
  "description": "Saves your Edubase books as PDF (desktop app)",
  "main": "main.js",
  "author": "Korel Uyar",
  "license": "GPL-3.0",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "dependencies": {
    "pdf-lib": "1.17.1"
  },
  "devDependencies": {
    "electron": "42.5.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "ch.edubase.downloader",
    "productName": "Edubase Downloader",
    "files": [
      "main.js",
      "preload.js",
      "edubase.js",
      "ui/**/*",
      "package.json"
    ],
    "mac": {
      "target": "dir",
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "identity": null
    }
  }
}
